{
  "name": "microduck-mcp",
  "version": "0.1.0",
  "description": "Agent-agnostic MCP server for the Pollen Robotics Microduck \u2014 by MicroduckHub",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "demo": "tsc && node scripts/demo.mjs",
    "record-demo": "node scripts/record-demo.mjs demo-rec",
    "compose-demo": "sim/.venv/bin/python scripts/compose-demo.py demo-rec"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "microduck",
    "pollen-robotics",
    "robot",
    "microduckhub"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "microduck-mcp": "dist/index.js"
  },
  "homepage": "https://microduckhub.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeynyc/microduck-mcp.git"
  }
}
