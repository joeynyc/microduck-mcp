{
  "name": "microduck-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.joeynyc/microduck-mcp",
  "description": "Agent-agnostic MCP server for the Pollen Robotics Microduck — by MicroduckHub",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "microduck",
    "pollen-robotics",
    "robot",
    "microduckhub"
  ],
  "homepage": "https://microduckhub.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeynyc/microduck-mcp.git"
  },
  "license": "Apache-2.0",
  "author": "joeynyc (https://microduckhub.com)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "microduck-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "sim/duck_sim.py",
    "sim/assets.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsc && node dist/cli.js",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "demo": "tsc && node scripts/demo.mjs",
    "record-demo": "node scripts/record-demo.mjs demo-rec",
    "compose-demo": "node dist/cli.js sim-python scripts/compose-demo.py demo-rec",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build && node --test \"dist/**/*.test.js\"",
    "setup-sim": "tsc && node dist/cli.js setup-sim",
    "gen-sim-assets": "node scripts/gen-sim-assets.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
